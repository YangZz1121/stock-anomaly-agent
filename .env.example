# 复制为 .env 后填写。.env 已在 .gitignore 中，不会进入仓库。
# 线上部署（Hugging Face Spaces）请使用 Space Secrets，不要提交任何密钥文件。
#
# 三个 Provider 默认都是 auto：填了密钥就走真实数据源，没填就自动降级到
# 内置构造数据集，并在页面顶部显示降级横幅。所以这个文件全部留空也能跑通。

# --- 扶摇金融数据 API（行情、指数、成分股）---
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# --- iFinD MCP（资讯、公告、研报）---
IFIND_MCP_URL=
IFIND_API_KEY=

# --- LLM（第二、三阶段的语义推理；不填则使用确定性启发式推理层）---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- 显式指定数据源，用于演示降级行为：auto | fuyao | ifind | openai | mock ---
MARKET_PROVIDER=auto
EVIDENCE_PROVIDER=auto
LLM_PROVIDER=auto
